# Copy to .env and adjust. All values here are dummies.
DATABASE_URL=postgresql+psycopg://crm:crm@localhost:5432/crm
CRM_BASE_URL=http://localhost:8000
# Only needed for `crm-pipeline report` without --no-llm.
ANTHROPIC_API_KEY=sk-ant-dummy-not-a-real-key
LLM_MODEL=claude-sonnet-5-5
# Optional: run the PostgreSQL integration tests (pytest -m integration).
TEST_PG_URL=postgresql+psycopg://crm:crm@localhost:5432/crm_test
